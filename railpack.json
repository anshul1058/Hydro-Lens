{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "packages": {
    "node": "22"
  },
  "steps": {
    "build": {
      "commands": ["...", "npm ci && npm run build"]
    }
  },
  "deploy": {
    "startCommand": "uvicorn api.main:app --host 0.0.0.0 --port $PORT",
    "aptPackages": ["libgl1", "libglib2.0-0", "libxcb1", "libxext6", "libxrender1"]
  }
}
